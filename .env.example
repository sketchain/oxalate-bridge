# Copy to .env (docker compose reads it). Never commit the real .env.

# PostgreSQL password used by docker-compose.yml.
POSTGRES_PASSWORD=change-me

# 32 random bytes, base64. Generate with: openssl rand -base64 32
BRIDGE_SECRET_KEY=

# First administrator, created on startup when the database has no admin.
BRIDGE_BOOTSTRAP_ADMIN_USERNAME=admin
BRIDGE_BOOTSTRAP_ADMIN_PASSWORD=change-me-too

# Schema of this project's tables, and of the cpa-quota plugin's tables
# (both in the same database).
BRIDGE_SCHEMA=bridge
BRIDGE_CPA_QUOTA_SCHEMA=cpa_quota

# Reverse proxies whose X-Forwarded-For is trusted (comma separated IPs/CIDRs).
BRIDGE_TRUSTED_PROXIES=

# Prometheus metrics listener; keep it private. Use 0.0.0.0:9090 inside a
# private network to let Prometheus scrape the container.
BRIDGE_METRICS_LISTEN=127.0.0.1:9090

# Set to false only when serving the panel over plain HTTP (local testing).
BRIDGE_COOKIE_SECURE=true

# Time zone used to cut days (admin overview "today"). IANA name.
BRIDGE_TIMEZONE=Asia/Shanghai

# debug | info | warn | error
BRIDGE_LOG_LEVEL=info
